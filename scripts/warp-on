#!/bin/bash

if ! systemctl is-active --quiet warp-svc; then
    pkexec systemctl start warp-svc.service || exit 1
fi

for i in {1..15}; do
    warp-cli status >/dev/null 2>&1 && break
    sleep 1
done

if ! warp-cli status >/dev/null 2>&1; then
    notify-send "Cloudflare WARP" "El servicio no responde"
    exit 1
fi

if warp-cli connect; then
    notify-send "Cloudflare WARP" "Conectando..."
else
    notify-send "Cloudflare WARP" "Error al conectar"
    exit 1
fi
